# مفتاح خدمة المساعد الذكي (يُستخدم على الخادم فقط، لا تضعه في كود الواجهة)
GEMINI_API_KEY=

# منفذ الخادم (اختياري)
PORT=3000

# مواقع إضافية مسموح لها باستدعاء الخادم، مفصولة بفاصلة (اختياري)
ALLOWED_ORIGINS=

# رابط الخادم المنشور بصيغة https، يُستخدم عند بناء تطبيق الأندرويد
# مثال: https://api.example.com
VITE_API_BASE_URL=
